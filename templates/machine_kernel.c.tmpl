/*
 * QEMU machine: {{MACHINE_NAME}} — 트랙 2 (커널 직부팅 + Android/유저스페이스)
 *
 * Generated by sboot-rehost plugin. Honest model — 진짜 커널·드라이버 실행,
 * 환경 (CPU/GIC/UART/SMC/스토리지 HCI) 만 모델. 우회는 PROGRESS.md + 우회목록.
 *
 * 모든 주소는 대상 DTB 도출 (아래 값은 채워 넣은 것 — 다른 기기 박제 금지):
 *  - DRAM base:        {{DRAM_BASE}}   (/memory reg)
 *  - GICD / GICR:      {{GICD_BASE}} / {{GICR_BASE}}
 *  - UART base:        {{UART_BASE}}   (earlycon {{EARLYCON}})
 *  - Storage HCI base: {{STORAGE_HCI_BASE}}  (K3, 없으면 미사용)
 *  - cmdline:          {{CMDLINE}}     (kvm-arm.mode=protected => HVC 는 커널 pKVM)
 */
#include "qemu/osdep.h"
#include "qapi/error.h"
#include "qemu/units.h"
#include "hw/boards.h"
#include "hw/qdev-properties.h"
#include "hw/arm/boot.h"
#include "hw/intc/arm_gicv3_common.h"
#include "hw/irq.h"
#include "sysemu/sysemu.h"
#include "chardev/char-fe.h"
#include "target/arm/cpu.h"
#include "cpu.h"
/* #include "{{STORAGE_HCI_HEADER}}"   // K3: 진짜 벤더 스토리지 HCI 모델 */

#define TYPE_KMACHINE MACHINE_TYPE_NAME("{{MACHINE_NAME}}")
OBJECT_DECLARE_SIMPLE_TYPE(KState, KMACHINE)

#define NUM_CPUS        {{NUM_CPUS}}
#define DRAM_BASE       {{DRAM_BASE}}ULL
#define GICD_BASE       {{GICD_BASE}}ULL
#define GICR_BASE       {{GICR_BASE}}ULL
#define UART_BASE       {{UART_BASE}}ULL
#define UART_TX_OFF     0x20   /* UTXH (Exynos 예; earlycon 패밀리로 확인) */
#define UART_RX_OFF     0x24   /* URXH */
#define UART_STAT_OFF   0x10   /* UTRSTAT */

struct KState {
    MachineState parent_obj;
    ARMCPU  *cpu[NUM_CPUS];
    DeviceState *gic;
    MemoryRegion uart, catchall;
    CharFrontend uart_chr;
    uint8_t  rx[256];
    unsigned rx_head, rx_tail, rx_count;
    /* ExynosUfs ufs;   // K3 */
};
static KState *g_k;

/* ---- UART (TX->chardev, RX FIFO + accept_input) ---- */
static int uart_can_rx(void *o){ KState *s=o; return sizeof(s->rx)-s->rx_count; }
static void uart_rx(void *o,const uint8_t *b,int n){ KState *s=o;
    for(int i=0;i<n&&s->rx_count<sizeof(s->rx);i++){ s->rx[s->rx_head]=b[i];
        s->rx_head=(s->rx_head+1)%sizeof(s->rx); s->rx_count++; } }
static uint64_t uart_read(void *o,hwaddr off,unsigned sz){ KState *s=o;
    if(off==UART_STAT_OFF){ uint64_t st=0x6; if(s->rx_count) st|=0x1; return st; }
    if(off==UART_RX_OFF && s->rx_count){ uint8_t b=s->rx[s->rx_tail];
        s->rx_tail=(s->rx_tail+1)%sizeof(s->rx); s->rx_count--;
        qemu_chr_fe_accept_input(&s->uart_chr);   /* ★ RX 흐름제어 필수 (instruction.md §8.2) */
        return b; }
    return 0; }
static void uart_write(void *o,hwaddr off,uint64_t v,unsigned sz){ KState *s=o;
    if(off==UART_TX_OFF){ uint8_t b=v; qemu_chr_fe_write_all(&s->uart_chr,&b,1); } }
static const MemoryRegionOps uart_ops={ .read=uart_read,.write=uart_write,
    .endianness=DEVICE_LITTLE_ENDIAN,
    .valid={.min_access_size=1,.max_access_size=4} };

/* ---- catch-all MMIO (fail-loud, 미모델 페리페럴 1 회 보고) ---- */
static uint64_t ca_read(void *o,hwaddr off,unsigned sz){
    static int n; if(n++<64) qemu_log("catchall RD 0x%"HWADDR_PRIx"\n",off); return 0; }
static void ca_write(void *o,hwaddr off,uint64_t v,unsigned sz){
    static int n; if(n++<64) qemu_log("catchall WR 0x%"HWADDR_PRIx"=0x%"PRIx64"\n",off,v); }
static const MemoryRegionOps ca_ops={ .read=ca_read,.write=ca_write,
    .endianness=DEVICE_LITTLE_ENDIAN };

/* ---- EL3 SMC 셤 (faithful=체인 ④ 모델). PSCI/eFuse/SiP. HVC 는 안 건드림 ---- */
/* QEMU 코어 3 패치 (scripts/patch_qemu_core.py) 로 SMC->EXCP_SMC 라우팅 후 여기로. */
static void smc_handler(CPUState *cs){
    ARMCPU *cpu=ARM_CPU(cs); CPUARMState *env=&cpu->env;
    uint32_t fn=env->xregs[0];
    /* PSCI (0x84.. / 0xC4..) -> QEMU PSCI 구현 */
    if((fn & 0x8400ff00u)==0x84000000u || (fn & 0xc400ff00u)==0xc4000000u){
        arm_handle_psci_call(cpu); return; }
    /* {{EFUSE_FNID}} eFuse/칩ID read -> 모델값 */
    /* if(fn=={{EFUSE_FNID}}){ env->xregs[0]={{EFUSE_VAL}}; return; } */
    env->xregs[0]=0; /* 그 외 SiP/LDFW -> SMCCC SUCCESS */
}

/* ---- DT 주입 (fstab / pcie / storage 노드) — libfdt ---- */
/* get_dtb 를 arm_boot info.modify_dtb_on_boot 로 걸어 fstab 등 주입.
 * 경로 A (제네릭+fstab): /firmware/android/fstab 에 system/vendor(erofs) 추가.
 * (methodology/track2_kernel_storage.md §6.1) */

static void k_reset(void *o){ /* 필요 시 CPU reset hook */ }

static void k_init(MachineState *ms){
    KState *s=KMACHINE(ms); MemoryRegion *sys=get_system_memory(); g_k=s;

    /* CPU (mp-affinity cluster.core) */
    for(int i=0;i<NUM_CPUS;i++){
        Object *o=object_new(ms->cpu_type);
        object_property_set_bool(o,"has_el2",true,&error_fatal);
        object_property_set_bool(o,"has_el3",false,&error_fatal);
        object_property_set_int(o,"mp-affinity",
            ((i/{{CORES_PER_CLUSTER}})<<8)|(i%{{CORES_PER_CLUSTER}}),&error_fatal);
        if(i) object_property_set_bool(o,"start-powered-off",true,&error_fatal);
        qdev_realize(DEVICE(o),NULL,&error_fatal);
        s->cpu[i]=ARM_CPU(o);
        /* SMC 셤 라우팅 (코어 패치) */
        /* CPU(o)->interrupt_handler = smc_handler; */
    }

    memory_region_add_subregion(sys,DRAM_BASE,ms->ram);

    /* catch-all (낮은 우선순위 overlap) */
    memory_region_init_io(&s->catchall,NULL,&ca_ops,s,"catchall",DRAM_BASE);
    memory_region_add_subregion_overlap(sys,0,&s->catchall,-1000);

    /* GICv3 + arch-timer PPI 풀 INTID 배선 (★ 상대번호 금지) */
    /* s->gic = ...arm-gicv3 (GICD_BASE/GICR_BASE); 타이머 PPI = 30/27/26/29 */

    /* UART */
    memory_region_init_io(&s->uart,NULL,&uart_ops,s,"uart",0x100);
    memory_region_add_subregion(sys,UART_BASE,&s->uart);
    if(serial_hd(0)){ qemu_chr_fe_init(&s->uart_chr,serial_hd(0),&error_abort);
        qemu_chr_fe_set_handlers(&s->uart_chr,uart_can_rx,uart_rx,NULL,NULL,s,NULL,true); }

    /* K3: 진짜 벤더 스토리지 HCI 연결 (interrupts SPI 는 DTB 도출) */
    /* e2400_ufs_realize(&s->ufs, sys, qdev_get_gpio_in(s->gic, {{STORAGE_SPI}})); */

    /* Path A 직부팅: Image + dtb + initrd */
    struct arm_boot_info bi = {0};
    bi.ram_size = ms->ram_size;
    bi.board_id = -1;
    bi.psci_conduit = QEMU_PSCI_CONDUIT_SMC;   /* ★ DISABLED 금지 */
    /* bi.modify_dtb_on_boot = get_dtb;  // fstab/pcie 주입 */
    arm_load_kernel(s->cpu[0], ms, &bi);

    qemu_register_reset(k_reset, s);
}

static void k_class_init(ObjectClass *oc,const void *d){
    MachineClass *mc=MACHINE_CLASS(oc);
    mc->desc="{{MODEL}} kernel direct-boot (sboot-rehost track 2)";
    mc->init=k_init;
    mc->max_cpus=NUM_CPUS; mc->default_cpus=NUM_CPUS;
    mc->default_cpu_type=ARM_CPU_TYPE_NAME("{{CPU_TYPE}}");
    mc->default_ram_id="{{MODEL_LOWER}}.dram";
    mc->default_ram_size={{DRAM_SIZE_MB}}ULL*MiB;
}
static const TypeInfo k_info={ .name=TYPE_KMACHINE,.parent=TYPE_MACHINE,
    .instance_size=sizeof(KState),.class_init=k_class_init };
static void k_register(void){ type_register_static(&k_info); }
type_init(k_register)
