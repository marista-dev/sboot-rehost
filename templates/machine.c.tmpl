/*
 * QEMU machine: sboot-{{MODEL_LOWER}}
 *
 * Generated by sboot-rehost plugin.
 * Honest model — see PROGRESS.md for bypass list.
 *
 * Key facts (도출):
 *  - BL3 linker addr: {{LINKER_BASE}}
 *  - BL3 load addr:   {{LOAD_BASE}}
 *  - RELOC_DELTA:     {{DELTA}} (uint32 add for ptrs)
 *  - Cmd table:       {{CMD_TABLE}} ({{NUM_CMDS}} entries x 0x20)
 *  - Cmd list head:   {{CMD_HEAD}}
 *  - Shell function:  {{SHELL_FUNC}}
 *  - Entry redirect:  {{ENTRY_REDIRECT}}
 */

#include "qemu/osdep.h"
#include "qapi/error.h"
#include "qemu/error-report.h"
#include "qemu/log.h"
#include "qemu/units.h"
#include "qom/object.h"
#include "hw/sysbus.h"
#include "hw/boards.h"
#include "hw/qdev-core.h"
#include "hw/loader.h"
#include "hw/arm/boot.h"
#include "system/reset.h"
#include "system/system.h"
