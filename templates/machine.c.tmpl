#define TYPE_SBOOT_MACHINE MACHINE_TYPE_NAME("sboot-{{MODEL_LOWER}}")
OBJECT_DECLARE_SIMPLE_TYPE(SbootState, SBOOT_MACHINE)

/* ---- Memory map ---- */
#define BL3_LOAD_ADDR   {{LOAD_BASE}}ULL
#define DRAM_BASE       {{DRAM_BASE}}ULL
#define DRAM_SIZE       ({{DRAM_SIZE_MB}}ULL * MiB)
#define PERI_LO_BASE    {{PERI_LO_BASE}}ULL
#define PERI_LO_SIZE    ({{PERI_LO_SIZE_MB}}ULL * MiB)
#define HEAP_RAM_BASE   {{HEAP_RAM_BASE}}ULL
#define HEAP_RAM_SIZE   (64ULL * MiB)

#define UART_BASE_OFF   {{UART_BASE_OFF}}ULL
#define UART_TX_OFF     (UART_BASE_OFF + 0x20)
#define UART_RX_OFF     (UART_BASE_OFF + 0x24)
#define UART_STAT_OFF   (UART_BASE_OFF + 0x10)

/* ---- Cmd table relocation constants ---- */
#define CMD_TABLE_ADDR  {{CMD_TABLE}}ULL
#define CMD_LIST_HEAD   {{CMD_HEAD}}ULL
#define RELOC_DELTA     {{DELTA}}U
#define NUM_CMDS        {{NUM_CMDS}}

/* ---- State ---- */
struct SbootState {
    MachineState parent_obj;
    ARMCPU *cpu;
    MemoryRegion peri_lo;
    MemoryRegion peri_mid;
    MemoryRegion peri_hi;
    MemoryRegion heap_ram;
    CharFrontend uart_chr;
    uint8_t  rx[256];
    unsigned rx_head, rx_tail, rx_count;
};

static SbootState *g_state;

/* ---- UART RX path ---- */
static int uart_can_receive(void *opaque) {
    SbootState *s = opaque;
    return sizeof(s->rx) - s->rx_count;
}
static void uart_receive(void *opaque, const uint8_t *buf, int sz) {
    SbootState *s = opaque;
    for (int i = 0; i < sz && s->rx_count < sizeof(s->rx); i++) {
        s->rx[s->rx_head] = buf[i];
        s->rx_head = (s->rx_head + 1) % sizeof(s->rx);
        s->rx_count++;
    }
}
static void rx_seed(SbootState *s, const char *str) {
    for (const char *p = str; *p && s->rx_count < sizeof(s->rx); p++) {
        s->rx[s->rx_head] = (uint8_t)*p;
        s->rx_head = (s->rx_head + 1) % sizeof(s->rx);
        s->rx_count++;
    }
}

/* ---- peri_lo MMIO (UART + catch-all) ---- */
static uint64_t peri_lo_read(void *opaque, hwaddr off, unsigned sz) {
    SbootState *s = opaque;
    if (off == UART_STAT_OFF) {
        uint64_t st = 0x6;
        if (s->rx_count > 0) st |= 0x1;
        return st;
    }
    if (off == UART_RX_OFF) {
        if (s->rx_count > 0) {
            uint8_t b = s->rx[s->rx_tail];
            s->rx_tail = (s->rx_tail + 1) % sizeof(s->rx);
            s->rx_count--;
            return b;
        }
        return 0;
    }
    /* CMU readback: 모든 0x...0xxx 폴링 영역 → 0xffffffff */
    if ((off & ~0xffULL) == (UART_BASE_OFF & ~0xffULL)) {
        return 0xffffffffull;
    }
    return 0;
}
static void peri_lo_write(void *opaque, hwaddr off, uint64_t val, unsigned sz) {
    SbootState *s = opaque;
    if (off == UART_TX_OFF) {
        uint8_t b = val & 0xff;
        qemu_chr_fe_write_all(&s->uart_chr, &b, 1);
        return;
    }
    /* silently absorb */
}

static const MemoryRegionOps peri_lo_ops = {
    .read       = peri_lo_read,
    .write      = peri_lo_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = { .min_access_size = 1, .max_access_size = 8 },
    .impl  = { .min_access_size = 1, .max_access_size = 4 },
};

/* ---- BL3 load + patches ---- */
static inline void wr32(uint8_t *ram, hwaddr base, uint64_t va, uint32_t v) {
    memcpy(ram + (va - base), &v, 4);
}
static inline void wr64(uint8_t *ram, hwaddr base, uint64_t va, uint64_t v) {
    memcpy(ram + (va - base), &v, 8);
}
static inline uint64_t rd64(uint8_t *ram, hwaddr base, uint64_t va) {
    uint64_t v; memcpy(&v, ram + (va - base), 8); return v;
}

static void apply_patches(uint8_t *ram, hwaddr base) {
    /* ============================================================
     * 우회 패치 — 매 행이 [대상/이유/방법/부작용] 정직성 §1.2
     * 자세한 목록은 06_machine/우회_패치_목록.md
     * ============================================================ */

    /* {{HANDOFF_MAGIC_BLOCK}}
     * BL2 → BL3 핸드오프 매직. 없으면 BL3 가 full re-init 경로로 가
     * device 의존이 깊어짐.
     */

    /* {{HEAP_STUB_BLOCK}}
     * Heap allocator 를 bump 으로 교체. free-list 가 진짜 init 안 돌아
     * traverse 무한 루프.
     */

    /* {{VTABLE_BLOCK}}
     * 콘솔 vtable 의 getchar/putchar/haschar 슬롯을 우리 UART stubs 로.
     * BL1/BL2 SRAM 함수는 우리 환경에 없음.
     */

    /* {{SHELL_MODE_BLOCK}}
     * Shell-mode/feature 체크들을 MOV W0,#1; RET 로 강제 통과.
     */

    /* UART stubs at high BL3 area (보통 0x...810000) — getchar/putchar/haschar
     * 자세한 인코딩은 worked_example.md 참조 */

    /* {{TRAMPOLINE_BLOCK}}
     * Entry redirect: EL setup 직후 첫 bl 을 트램폴린으로 점프.
     * 트램폴린은 SP 세팅 + UFCON 활성화 + shell 함수 직호출.
     * 이게 device init 전체 스킵의 핵심.
     */

    /* {{CMD_RELOC_BLOCK}}
     * 19 (또는 NUM_CMDS) 엔트리 × 3 ptr (name, help, handler) 에
     * +RELOC_DELTA (uint32). 그리고 next 체인 + list head.
     */
    for (int i = 0; i < NUM_CMDS; i++) {
        uint64_t entry = CMD_TABLE_ADDR + i * 0x20;
        for (int field = 0; field < 3; field++) {
            uint64_t v = rd64(ram, base, entry + field * 8);
            uint32_t relocated = (uint32_t)(v & 0xFFFFFFFF) + RELOC_DELTA;
            wr64(ram, base, entry + field * 8, (uint64_t)relocated);
        }
        uint64_t nxt = (i < NUM_CMDS - 1) ? (entry + 0x20) : 0ULL;
        wr64(ram, base, entry + 0x18, nxt);
    }
    wr64(ram, base, CMD_LIST_HEAD, CMD_TABLE_ADDR);

    /* {{ENV_RELOC_BLOCK}}
     * Env 테이블 (보통 ~94 엔트리) 의 name ptr 들도 +RELOC_DELTA.
     */

    info_report("sboot-{{MODEL_LOWER}}: cmd table relocated, head @0x%llx",
                (unsigned long long)CMD_LIST_HEAD);
}

static void load_bl3(SbootState *s, MachineState *ms) {
    if (!ms->kernel_filename) {
        error_report("no -kernel <bl3.bin>"); exit(1);
    }
    FILE *f = fopen(ms->kernel_filename, "rb");
    if (!f) { error_report("cannot open '%s'", ms->kernel_filename); exit(1); }
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (sz <= 0) { error_report("empty bl3"); exit(1); }
    uint8_t *buf = g_malloc0(sz);
    if (fread(buf, 1, sz, f) != (size_t)sz) {
        error_report("short read"); exit(1);
    }
    fclose(f);

    uint8_t *ram = memory_region_get_ram_ptr(ms->ram);
    hwaddr off = BL3_LOAD_ADDR - DRAM_BASE;
    memcpy(ram + off, buf, sz);     /* ★ cpu_physical_memory_write 금지 (TCG stale) */
    g_free(buf);

    apply_patches(ram, DRAM_BASE);
    info_report("sboot-{{MODEL_LOWER}}: BL3 loaded (%ld bytes) at 0x%llx",
                sz, (unsigned long long)BL3_LOAD_ADDR);
}

/* ---- CPU reset hook ---- */
static void cpu_reset_hook(void *opaque) {
    ARMCPU *cpu = opaque;
    CPUState *cs = CPU(cpu);
    cpu_reset(cs);
    cpu_set_pc(cs, (vaddr)BL3_LOAD_ADDR);
    CPUARMState *env = &cpu->env;
    env->cp15.sctlr_el[1] = 0;
    env->cp15.sctlr_el[2] = 0;
    env->cp15.cpacr_el1 = 0x300000ULL;
}

/* ---- Machine init ---- */
static void sboot_init(MachineState *ms) {
    SbootState *s = SBOOT_MACHINE(ms);
    MemoryRegion *sysmem = get_system_memory();
    g_state = s;

    /* {{CPU_BLOCK}}
     * CPU type 과 has_el3/el2 는 INPUT.md 의 추측을 기반.
     */
    Object *cpuobj = object_new(ms->cpu_type);
    object_property_set_bool(cpuobj, "has_el3", {{HAS_EL3}}, &error_fatal);
    object_property_set_bool(cpuobj, "has_el2", {{HAS_EL2}}, &error_fatal);
    qdev_realize(DEVICE(cpuobj), NULL, &error_fatal);
    s->cpu = ARM_CPU(cpuobj);

    memory_region_add_subregion(sysmem, DRAM_BASE, ms->ram);

    memory_region_init_ram(&s->heap_ram, NULL, "sboot.heap",
                           HEAP_RAM_SIZE, &error_fatal);
    memory_region_add_subregion(sysmem, HEAP_RAM_BASE, &s->heap_ram);

    memory_region_init_io(&s->peri_lo, NULL, &peri_lo_ops, s,
                          "sboot.peri_lo", PERI_LO_SIZE);
    memory_region_add_subregion(sysmem, PERI_LO_BASE, &s->peri_lo);

    memory_region_init_io(&s->peri_mid, NULL, &peri_lo_ops, s,
                          "sboot.peri_mid", 0x10000000ULL);
    memory_region_add_subregion(sysmem, 0x20000000ULL, &s->peri_mid);

    memory_region_init_io(&s->peri_hi, NULL, &peri_lo_ops, s,
                          "sboot.peri_hi", 0x0e000000ULL);
    memory_region_add_subregion(sysmem, 0x02000000ULL, &s->peri_hi);

    if (serial_hd(0)) {
        qemu_chr_fe_init(&s->uart_chr, serial_hd(0), &error_abort);
        qemu_chr_fe_set_handlers(&s->uart_chr, uart_can_receive,
                                 uart_receive, NULL, NULL, s, NULL, true);
    }

    {
        const char *seed = ms->kernel_cmdline;
        if (seed && seed[0]) {
            rx_seed(s, seed);
            rx_seed(s, "\r");
        } else {
            rx_seed(s, "help\r");
        }
    }

    load_bl3(s, ms);

    qemu_register_reset(cpu_reset_hook, s->cpu);
}

static const char * const sboot_valid_cpu_types[] = {
    ARM_CPU_TYPE_NAME("{{CPU_TYPE}}"),
    NULL,
};

static void sboot_class_init(ObjectClass *oc, const void *data) {
    MachineClass *mc = MACHINE_CLASS(oc);
    mc->desc           = "Samsung S-Boot — {{MODEL}} (auto-generated by sboot-rehost)";
    mc->init           = sboot_init;
    mc->max_cpus       = 1;
    mc->min_cpus       = 1;
    mc->default_cpus   = 1;
    mc->default_cpu_type = ARM_CPU_TYPE_NAME("{{CPU_TYPE}}");
    mc->valid_cpu_types  = sboot_valid_cpu_types;
    mc->default_ram_size = DRAM_SIZE;
    mc->default_ram_id   = "sboot.dram";
}

static const TypeInfo sboot_info = {
    .name           = TYPE_SBOOT_MACHINE,
    .parent         = TYPE_MACHINE,
    .instance_size  = sizeof(SbootState),
    .class_init     = sboot_class_init,
    .interfaces     = arm_aarch64_machine_interfaces,
};

static void sboot_register(void) {
    type_register_static(&sboot_info);
}
type_init(sboot_register)
